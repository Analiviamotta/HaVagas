<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"

        tools:context=".MainActivity"

        android:paddingVertical="32dp"
        android:paddingHorizontal="16dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/ha_vagas_tv"

            android:text="@string/title"

            android:textSize="35sp"
            android:textStyle="bold"


            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/name_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ha_vagas_tv">

            <TextView
                android:id="@+id/name_tv"

                android:text="@string/full_name"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <EditText
                android:id="@+id/nameEt"

                android:hint="@string/name_hint"

                android:inputType="textPersonName"

                android:background="@color/background_input"

                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/email_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name_ll">

            <TextView
                android:id="@+id/email_tv"

                android:text="@string/e_mail"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <EditText
                android:id="@+id/emailEt"

                android:hint="@string/e_mail_hint"

                android:inputType="textEmailAddress"

                android:background="@color/background_input"

                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:id="@+id/email_notifications_cb"

                android:checked="true"
                android:text="@string/email_notify"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintStart_toStartOf="parent"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/email_ll">

            <TextView
                android:id="@+id/phone_tv"

                android:text="@string/phone"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <EditText
                android:id="@+id/phone_Et"

                android:hint="@string/phone_hint"

                android:inputType="phone"

                android:background="@color/background_input"

                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/phone_type_tv"

                android:text="@string/phone_type_tv"

                android:textSize="16sp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/phone_type_rg"

                android:gravity="center"
                android:orientation="horizontal"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioButton
                    android:id="@+id/commercial_phone_rb"

                    android:checked="true"

                    android:layout_width="0dp"
                    android:layout_weight="1"

                    android:text="@string/commercial"

                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/residential_rb"


                    android:layout_width="0dp"
                    android:layout_weight="1"

                    android:text="@string/residential"

                    android:layout_height="wrap_content"/>

            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellphone_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/phone_ll">

            <CheckBox
                android:id="@+id/add_cellphone_cb"

                android:checked="false"

                android:text="@string/add_cellphone"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/cell_phone_number_ll"

                android:visibility="gone"
                android:orientation="vertical"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/cellphone_tv"

                    android:text="@string/cellphone"

                    android:textSize="20sp"
                    android:textStyle="bold"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <EditText
                    android:id="@+id/cellphone_Et"

                    android:hint="@string/cellphone_hint"

                    android:inputType="phone"

                    android:background="@color/background_input"

                    android:paddingVertical="12dp"
                    android:paddingHorizontal="8dp"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/gender_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cellphone_ll">

            <TextView
                android:id="@+id/gender"

                android:text="@string/gender"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />



            <RadioGroup
                android:id="@+id/gender_rg"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/female_rb"

                    android:checked="true"

                    android:text="@string/female"

                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/male_rb"

                    android:text="@string/male"

                    android:layout_weight="1"
                    android:layout_width="0dp"

                    android:layout_height="wrap_content"/>
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/birthday_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gender_ll">

            <TextView
                android:id="@+id/birthday_tv"

                android:text="Preencha sua data de aniversário"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <EditText
                android:id="@+id/birthday_et"

                android:hint="@string/birthday_hint"


                android:inputType="date"

                android:background="@color/background_input"

                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/degree_ll"
            android:paddingVertical="16dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/birthday_ll">

            <TextView
                android:id="@+id/degree_tv"

                android:text="@string/degree"

                android:textSize="20sp"
                android:textStyle="bold"

                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <Spinner
                android:id="@+id/degree_sp"

                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:entries="@array/degree_options"

                android:background="@color/background_input"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:id="@+id/degree_year_ll"

                android:visibility="gone"
                android:orientation="vertical"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/degree_year_tv"

                    android:text="@string/degree_year"

                    android:textSize="16sp"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <EditText
                    android:id="@+id/degree_year_et"

                    android:hint="@string/degree_year_hint"

                    android:inputType="number"

                    android:background="@color/background_input"

                    android:paddingVertical="12dp"
                    android:paddingHorizontal="8dp"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>